# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by match sync jobs — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Football-Data.org v4 (https://www.football-data.org/)
FOOTBALL_DATA_API_KEY=

# Optional. When set, GET /api/cron/sync requires Authorization: Bearer <CRON_SECRET>.
# Vercel Cron sends this header automatically if the env var is named CRON_SECRET.
CRON_SECRET=
